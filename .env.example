# Loopgate GenAI Explanation Environment Configuration
# Copy this file to .env.local for local execution
# NEVER commit .env.local or hardcode secret keys.
# All keys are optional. If no keys are provided, Loopgate uses
# deterministic template explanations with zero external calls.

# 1. Google Gemini (Priority 1)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq (Priority 2)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter (Priority 3 - free tier model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4. Generic OpenAI-Compatible Gateway (Development Only, e.g. OmniRoute localhost)
# Automatically disabled when NODE_ENV=production
AI_COMPAT_BASE_URL=
AI_COMPAT_API_KEY=
AI_COMPAT_MODEL=
